# Firebase web app configuration (Project settings -> General -> Your apps -> Web app).
# Copy this file to .env.local for local work, and set the same keys in Vercel
# for Production builds.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set to true when using `npm run emulators` for local development.
# Never enable this in a production build.
VITE_USE_EMULATORS=false
